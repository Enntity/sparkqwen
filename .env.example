# Copy to .env and edit. Set WORKER and, if discovery is ambiguous, fabric overrides.

# ssh destination of the second Spark (rank 1). Passwordless ssh, and its user
# can run docker. Its address on the direct cable makes the one-time copy of
# the ~102 GB checkpoint much faster.
WORKER=you@192.0.2.2

# Where the checkpoint lives (~102 GB). The same absolute path is used on both
# Sparks. Default: $HOME/models/sparkqwen. Each Spark also keeps a ~31 GB packed
# copy of the PLE n-gram table in ~/.cache/atlas-ple, written on the first start.
#MODEL_ROOT=/srv/models/sparkqwen

# 8x32k (default): 8 requests x 32K context, the measured concurrency profile.
# 4x262k: 4 requests x 256K context (docs/LIMITATIONS.md, Long context).
# 8x262k: 8 requests x 256K context from one shared ~3.35M-token KV pool.
#PROFILE=8x32k

# Share of each Spark's unified memory for the engine (two decimals, 0.70-0.95,
# default 0.88; see .env.sidecars.example for measured0.70). A lower share reserves host
# and service memory but shrinks the shared KV token pool; no context or
# concurrency promise. GB10 hosts can hang when memory runs out; keep several GB
# free and raise it only on Sparks that run nothing else.
#GPU_MEMORY_UTILIZATION=0.88
#
# Sharing the Sparks with sidecars? Use .env.sidecars.example instead: the
# measured arrangement is PROFILE=8x262k at GPU_MEMORY_UTILIZATION=0.70 on
# BOTH ranks (see docs/LIMITATIONS.md, Running beside sidecars).

# Serve another checkpoint on the same image: both values or neither. The engine
# also loads NVIDIA's earlier NVFP4 release (124 GiB, the RC16 default):
#CHECKPOINT_REPO=nvidia/Qwen3.8-Flash-Next-NVFP4
#CHECKPOINT_REVISION=fc694b54fb0174e0913e6adf86691ef85a4ead47

# Opt-in, lossy, NVFP4 checkpoint only: FP8 projections for the Gated DeltaNet
# layers. 1-12% faster one-stream decode with the 2026-10-06 engine (not
# measured with RC15), and outputs are not bit-exact against the default.
# FP4-Local already decodes these layers from its own MXFP8 weights, and the
# engine refuses this switch on it. Default off; set 0 or delete the line.
#FP8_GDN=1

# start.sh pulls ghcr.io/enntity/atlas-sparkqwen:<install tree> for this
# checkout and builds from source only if that tag is not published.
# PULL=0 always builds from source.
#PULL=0
# Parallel compile jobs for a source build; lower it if the build runs out of memory.
#ATLAS_BUILD_JOBS=4

# Only for private Hugging Face mirrors; the pinned checkpoint is public.
#HF_TOKEN=

# Resolve each node's active RDMA interface independently. With no overrides,
# exactly one matching IPv4 subnet pair is required; ambiguous discovery stops.
# ./start.sh fabric checks selection without Docker, downloads or model changes.
# Override each host independently (the same physical port number is not required).
# List ALL intended rails, in matching peer order; extra siblings are not added.
#LEADER_FABRIC_HCA=rocep1s0f1,roceP2p1s0f1
#WORKER_FABRIC_HCA=rocep1s0f0,roceP2p1s0f0
#LEADER_FABRIC_INTERFACE=enp1s0f1np1
#WORKER_FABRIC_INTERFACE=enp1s0f0np0
# FABRIC_HCA / FABRIC_INTERFACE remain shared fallbacks for either unset side.
# LEADER_ADDRESS, if set, must belong to the selected leader interface.
#LEADER_ADDRESS=192.0.2.1
