.env
__pycache__/
*.py[cod]
.venv/

# Benchmark outputs; published receipts belong under results/.
bench/*.json
bench/*.jsonl

# Never commit weights, compiled GPU artifacts or credentials.
*.safetensors
*.bin
*.so
*.key
*.pem
.claude/

# Finder metadata. install/.DS_Store was committed by mistake in 0.7.0 and is
# part of that image tag (the install/ tree hash); remove it with the next
# image build, not before.
.DS_Store
