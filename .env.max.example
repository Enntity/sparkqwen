# SPDX-License-Identifier: AGPL-3.0-only
# Dedicated TP2 pair: 16 scheduler slots, 262144 tokens per request.
# Qualified in Spark mode; see the release receipt for measured capacity.
# Do not use this profile alongside GPU sidecars.
WORKER=you@worker.example
PROFILE=max-16x262k
MODE=spark
# Qualification uses Spark mode; Strict must be sized separately.
# Both ranks must use the same profile. DISPLAY_FRM carveout is enabled.
# PULL=0 builds the pinned source rather than pulling a published image.
#PULL=0
